{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tervixa Wiggle",
  "mainBinaryName": "Tervixa Wiggle",
  "version": "1.0.0",
  "identifier": "com.tervixa.wiggle",
  "build": {
    "frontendDist": "../../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tervixa Wiggle",
        "url": "http://127.0.0.1:4317",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Tervixa Corporation",
    "copyright": "MIT License. Developed by Tervixa Corporation.",
    "category": "DeveloperTool",
    "shortDescription": "Tervixa Wiggle - AI Software Engineering Workbench",
    "longDescription": "Local-first AI software engineering workbench by Tervixa Corporation. Ships its own Node runtime, the agent gateway, the workbench interface and the provider, plugin and connector catalogs.",
    "resources": ["resources/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
